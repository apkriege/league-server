// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model session {
  sid    String   @id
  sess   Json
  expire DateTime @db.Timestamptz(3)

  @@index([expire])
}

enum Gender {
  male
  female
}

model user {
  id              Int       @id @default(autoincrement())
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  email           String    @unique
  username        String?   @unique
  googleId        String?   @unique @map("google_id")
  password        String
  role            String    @default("USER") // USER, ADMIN, SUPER
  phone           String?
  metadata        Json?
  emailVerifiedAt DateTime? @default(now()) @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  manager                      league[]
  players                      player[]
  sentLeagueInvitations        league_invitation[]             @relation("league_invitation_invited_by")
  claimedLeagueInvitations     league_invitation[]             @relation("league_invitation_claimed_by")
  passwordResetTokens          password_reset_token[]
  emailVerificationTokens      email_verification_token[]
  leagueAnnouncements          league_announcement[]
  leagueAnnouncementDismissals league_announcement_dismissal[]
  auditLogs                    audit_log[]
  supportMessages              support_message[]
  createdPaymentBypassCodes    payment_bypass_code[]           @relation("payment_bypass_code_created_by")
  redeemedPaymentBypassCodes   payment_bypass_code[]           @relation("payment_bypass_code_redeemed_by")
  seasonEntitlements           league_season_entitlement[]     @relation("league_season_entitlement_billing_owner")

  @@index([email])
  @@index([deletedAt])
}

model support_message {
  id            Int      @id @default(autoincrement())
  requesterId   Int      @map("requester_id")
  category      String
  subject       String
  message       String
  emailStatus   String   @default("pending") @map("email_status")
  emailId       String?  @map("email_id")
  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  requester user @relation(fields: [requesterId], references: [id])

  @@index([requesterId])
  @@index([emailStatus])
  @@index([createdAt])
}

model password_reset_token {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model email_verification_token {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  redirectPath String    @default("/leagues/create") @map("redirect_path")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model stripe_checkout_completion {
  id               Int       @id @default(autoincrement())
  sessionId        String    @unique @map("session_id")
  paymentIntentId  String?   @unique @map("payment_intent_id")
  userId           Int       @map("user_id")
  leagueId         Int?      @map("league_id")
  entitlementId    Int?      @map("entitlement_id")
  purpose          String
  quantity         Int
  targetGolfers    Int       @map("target_golfers")
  refundedQuantity Int       @default(0) @map("refunded_quantity")
  refundedAt       DateTime? @map("refunded_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  entitlement league_season_entitlement? @relation(fields: [entitlementId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([leagueId])
  @@index([entitlementId])
}

model league_season_entitlement {
  id                  Int      @id @default(autoincrement())
  billingOwnerId      Int      @map("billing_owner_id")
  draftKey            String   @map("draft_key")
  renewedFromLeagueId Int?     @map("renewed_from_league_id")
  requiredGolfers     Int      @map("required_golfers")
  paidGolfers         Int      @default(0) @map("paid_golfers")
  refundedGolfers     Int      @default(0) @map("refunded_golfers")
  status              String   @default("pending_payment")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  billingOwner user                         @relation("league_season_entitlement_billing_owner", fields: [billingOwnerId], references: [id], onDelete: Restrict)
  league       league?
  checkouts    stripe_checkout_completion[]

  @@unique([billingOwnerId, draftKey])
  @@index([billingOwnerId])
  @@index([renewedFromLeagueId])
  @@index([status])
}

model payment_bypass_code {
  id               Int       @id @default(autoincrement())
  codeHash         String    @unique @map("code_hash")
  codeHint         String    @map("code_hint")
  label            String?
  createdById      Int       @map("created_by_id")
  redeemedById     Int?      @map("redeemed_by_id")
  redeemedLeagueId Int?      @unique @map("redeemed_league_id")
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(3)
  redeemedAt       DateTime? @map("redeemed_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy      user    @relation("payment_bypass_code_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  redeemedBy     user?   @relation("payment_bypass_code_redeemed_by", fields: [redeemedById], references: [id], onDelete: SetNull)
  redeemedLeague league? @relation(fields: [redeemedLeagueId], references: [id], onDelete: Restrict)

  @@index([createdById])
  @@index([redeemedById])
  @@index([expiresAt])
  @@index([redeemedAt])
  @@index([revokedAt])
}

model club {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  logo        String?
  location    String?
  phone       String?
  link        String?
  accessType  String    @default("public") @map("type")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  courses course[]

  @@index([deletedAt])
}

model course {
  id          Int       @id @default(autoincrement())
  clubId      Int       @map("club_id")
  name        String
  description String?
  location    String?
  phone       String?
  timeZone    String    @default("America/Detroit") @map("time_zone")
  accessType  String    @default("public") @map("type")
  numHoles    Int?      @map("num_holes")
  par         Int
  externalProvider String?   @map("external_provider")
  externalId       String?   @map("external_id")
  scorecardUrl     String?   @map("scorecard_url")
  sourceUpdatedAt  DateTime? @map("source_updated_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  club       club         @relation(fields: [clubId], references: [id])
  tees       tee[]
  events     event[]
  rounds     round[]
  teamRounds team_round[]

  @@index([clubId])
  @@index([deletedAt])
  @@unique([externalProvider, externalId])
}

model tee {
  id               Int       @id @default(autoincrement())
  courseId         Int       @map("course_id")
  name             String
  color            String
  distance         Int
  par              Int
  frontPar         Int       @map("front_par")
  backPar          Int       @map("back_par")
  slopeMen         Int?      @map("slope_men") // Official full-course slope for men
  slopeFrontMen    Int?      @map("slope_front_men") // Official front-nine slope for men
  slopeBackMen     Int?      @map("slope_back_men") // Official back-nine slope for men
  slopeWomen       Int?      @map("slope_women") // USGA slope for women, full course
  slopeFrontWomen  Int?      @map("slope_front_women") // USGA slope for women, front 9
  slopeBackWomen   Int?      @map("slope_back_women") // USGA slope for women, back 9
  ratingMen        Float?    @map("rating_men") // Official full-course rating for men
  ratingFrontMen   Float?    @map("rating_front_men") // Official front-nine rating for men
  ratingBackMen    Float?    @map("rating_back_men") // Official back-nine rating for men
  ratingWomen      Float?    @map("rating_women") // USGA rating for women, full course
  ratingFrontWomen Float?    @map("rating_front_women") // USGA rating for women, front 9
  ratingBackWomen  Float?    @map("rating_back_women") // USGA rating for women, back 9
  holes            Json[]
  holesWomen       Json[]    @default([]) @map("holes_women")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  course     course?      @relation(fields: [courseId], references: [id])
  events     event[]
  rounds     round[]
  teamRounds team_round[]

  @@index([courseId])
  @@index([deletedAt])
}

model league {
  id                    Int       @id @default(autoincrement())
  name                  String
  description           String?
  type                  String
  holeFormat            String    @default("18") @map("hole_format")
  viewerAccessCode      String?   @unique @map("viewer_access_code")
  format                String? // e.g. "individual", "team"
  adminId               Int       @map("admin_id")
  renewedFromLeagueId   Int?      @unique @map("renewed_from_league_id")
  entitlementId         Int       @unique @map("entitlement_id")
  seasonStatus          String    @default("active") @map("season_status")
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(3)
  renewalReminderSentAt DateTime? @map("renewal_reminder_sent_at") @db.Timestamptz(3)
  startDate             DateTime  @map("start_date") @db.Date
  endDate               DateTime  @map("end_date") @db.Date
  contactFirstName      String    @map("contact_first")
  contactLastName       String    @map("contact_last")
  contactEmail          String    @map("contact_email")
  contactPhone          String?   @map("contact_phone")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)

  admin             user                       @relation(fields: [adminId], references: [id])
  renewedFromLeague league?                    @relation("LeagueSeasonRenewal", fields: [renewedFromLeagueId], references: [id], onDelete: Restrict)
  renewedLeague     league?                    @relation("LeagueSeasonRenewal")
  entitlement       league_season_entitlement  @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  events            event[]
  players           player[]
  teams             team[]
  teamEventPoints   team_event_points[]
  invitations       league_invitation[]
  announcements     league_announcement[]
  scoringPeriods    league_scoring_period[]
  auditLogs         audit_log[]
  onboarding        league_onboarding?
  paymentBypassCode payment_bypass_code?

  @@index([adminId])
  @@index([renewedFromLeagueId])
  @@index([entitlementId])
  @@index([seasonStatus])
  @@index([startDate])
  @@index([deletedAt])
}

model league_scoring_period {
  id        Int      @id @default(autoincrement())
  leagueId  Int      @map("league_id")
  name      String
  position  Int
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  league league @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, position])
  @@index([leagueId])
  @@index([startDate])
  @@index([endDate])
}

model player {
  id               Int       @id @default(autoincrement())
  userId           Int?      @map("user_id")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  email            String?
  phone            String?
  gender           Gender    @default(male)
  handicap         Float
  startingHandicap Float     @map("starting_handicap")
  seasonPoints     Float     @map("season_points")
  seasonRank       Int?      @map("season_rank")
  type             String    @default("player") @map("type") // player, substitute, captain
  leagueId         Int?      @map("league_id")
  teamId           Int?      @map("team_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  league        league?             @relation(fields: [leagueId], references: [id])
  team          team?               @relation(fields: [teamId], references: [id])
  flightPlayers flight_player[]
  rounds        round[]             @relation("round_playerId")
  opponentOf    round[]             @relation("round_opponentId")
  user          user?               @relation(fields: [userId], references: [id])
  invitations   league_invitation[]

  @@index([leagueId])
  @@index([teamId])
  @@index([email])
  @@index([deletedAt])
}

model team {
  id           Int       @id @default(autoincrement())
  name         String
  leagueId     Int?      @map("league_id")
  seasonPoints Float     @map("season_points")
  seasonRank   Int?      @map("season_rank")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  league          league?             @relation(fields: [leagueId], references: [id])
  players         player[]
  flightTeams     flight_team[]
  teamEventPoints team_event_points[]
  teamRounds      team_round[]

  @@index([leagueId])
  @@index([deletedAt])
}

model event {
  id            Int       @id @default(autoincrement())
  leagueId      Int       @map("league_id")
  courseId      Int       @map("course_id")
  teeId         Int       @map("tee_id")
  name          String
  format        String    @map("format") // e.g. "individual", "team"
  type          String    @map("type") // e.g. "regular", "playoff", "tournament"
  holes         Int       @map("holes")
  startSide     String    @map("start_side")
  startsAt      DateTime  @map("starts_at") @db.Timestamptz(3)
  timeZone      String    @map("time_zone")
  interval      Int
  scoringMode   String    @default("stroke-play") @map("scoring_mode")
  scoringConfig Json?     @map("scoring_config")
  ptsPerHole    Int?      @map("pts_per_hole")
  ptsPerMatch   Int?      @map("pts_per_match")
  ptsPerTeamWin Int?      @map("pts_per_team_win")
  strokePoints  Json?     @map("stroke_points")
  pointsEnabled Boolean   @default(true) @map("points_enabled")
  status        String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  league          league              @relation(fields: [leagueId], references: [id])
  course          course              @relation(fields: [courseId], references: [id])
  tee             tee                 @relation(fields: [teeId], references: [id])
  flights         flight[]
  rounds          round[]
  teamEventPoints team_event_points[]
  teamRounds      team_round[]

  @@index([leagueId])
  @@index([courseId])
  @@index([teeId])
  @@index([startsAt])
  @@index([status])
  @@index([deletedAt])
}

model team_event_points {
  id        Int      @id @default(autoincrement())
  leagueId  Int      @map("league_id")
  teamId    Int      @map("team_id")
  eventId   Int      @map("event_id")
  points    Float
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  league league @relation(fields: [leagueId], references: [id])
  team   team   @relation(fields: [teamId], references: [id])
  event  event  @relation(fields: [eventId], references: [id])

  @@unique([teamId, eventId])
  @@index([leagueId, eventId])
  @@index([teamId])
}

model flight {
  id        Int       @id @default(autoincrement())
  eventId   Int       @map("event_id")
  status    String    @default("not_started")
  startsAt  DateTime  @map("starts_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  event      event           @relation(fields: [eventId], references: [id])
  players    flight_player[]
  teams      flight_team[]
  teamRounds team_round[]

  @@index([eventId])
  @@index([deletedAt])
}

model flight_player {
  id         Int       @id @default(autoincrement())
  flightId   Int       @map("flight_id")
  playerId   Int       @map("player_id")
  teamId     Int?      @map("team_id")
  opponentId Int?      @map("opponent_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  flight flight @relation(fields: [flightId], references: [id])
  player player @relation(fields: [playerId], references: [id])

  @@index([flightId])
  @@index([playerId])
  @@index([opponentId])
  @@index([deletedAt])
}

model flight_team {
  id         Int       @id @default(autoincrement())
  flightId   Int       @map("flight_id")
  teamId     Int       @map("team_id")
  opponentId Int?      @map("opponent_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  flight flight @relation(fields: [flightId], references: [id])
  team   team?  @relation(fields: [teamId], references: [id])

  @@index([flightId])
  @@index([teamId])
  @@index([opponentId])
  @@index([deletedAt])
}

model round {
  id              Int       @id @default(autoincrement())
  eventId         Int       @map("event_id")
  playerId        Int       @map("player_id")
  opponentId      Int?      @map("opponent_id")
  courseId        Int       @map("course_id")
  teeId           Int       @map("tee_id")
  status          String    @default("not_started") // not_started, in_progress, completed
  holesPlayed     Int       @map("holes_played")
  gross           Int
  net             Int
  adjusted        Int
  putts           Int
  courseRating    Float     @map("course_rating")
  courseSlope     Float     @map("course_slope")
  courseHandicap  Int?      @map("course_handicap")
  differential    Float?
  preHandicap     Float?    @map("pre_handicap")
  postHandicap    Float?    @map("post_handicap")
  pointsEarned    Float     @map("points_earned")
  matchPoints     Float     @default(0) @map("match_points")
  eagles          Int
  birdies         Int
  pars            Int
  bogeys          Int
  doubleBogeys    Int       @map("double_bogeys")
  tripleBogeys    Int       @map("triple_bogeys")
  netEagles       Int?      @map("net_eagles")
  netBirdies      Int?      @map("net_birdies")
  netPars         Int?      @map("net_pars")
  netBogeys       Int?      @map("net_bogeys")
  netDoubleBogeys Int?      @map("net_double_bogeys")
  netTripleBogeys Int?      @map("net_triple_bogeys")
  date            DateTime  @map("played_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  event    event   @relation(fields: [eventId], references: [id])
  player   player  @relation("round_playerId", fields: [playerId], references: [id])
  opponent player? @relation("round_opponentId", fields: [opponentId], references: [id])
  course   course  @relation(fields: [courseId], references: [id])
  tee      tee     @relation(fields: [teeId], references: [id])
  scores   score[]

  @@unique([eventId, playerId])
  @@index([eventId])
  @@index([playerId])
  @@index([opponentId])
  @@index([courseId])
  @@index([teeId])
  @@index([deletedAt])
}

model score {
  id             Int      @id @default(autoincrement())
  roundId        Int      @map("round_id")
  hole           Int
  par            Int
  gross          Int
  net            Int
  adjusted       Int
  putts          Int?
  fairwayHit     Boolean? @map("fairway_hit")
  gir            Boolean?
  sandSave       Boolean? @map("sand_save")
  penaltyStrokes Int?     @map("penalty_strokes")
  popsReceived   Int?     @map("pops_received")
  points         Float    @default(0) @map("points")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  round  round  @relation(fields: [roundId], references: [id])

  @@unique([roundId, hole])
  @@index([roundId])
  @@index([hole])
}

model team_round {
  id                Int       @id @default(autoincrement())
  eventId           Int       @map("event_id")
  flightId          Int?      @map("flight_id")
  teamId            Int       @map("team_id")
  courseId          Int       @map("course_id")
  teeId             Int       @map("tee_id")
  status            String    @default("not_started")
  holesPlayed       Int       @map("holes_played")
  gross             Int
  net               Int
  adjusted          Int
  courseHandicap    Int?      @map("course_handicap")
  handicapAllowance Float?    @map("handicap_allowance")
  handicapSnapshot  Json?     @map("handicap_snapshot")
  pointsEarned      Float     @default(0) @map("points_earned")
  matchPoints       Float     @default(0) @map("match_points")
  date              DateTime  @map("played_date") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  event  event        @relation(fields: [eventId], references: [id])
  flight flight?      @relation(fields: [flightId], references: [id])
  team   team         @relation(fields: [teamId], references: [id])
  course course       @relation(fields: [courseId], references: [id])
  tee    tee          @relation(fields: [teeId], references: [id])
  scores team_score[]

  @@unique([eventId, teamId])
  @@index([eventId])
  @@index([flightId])
  @@index([teamId])
  @@index([courseId])
  @@index([teeId])
  @@index([status])
  @@index([deletedAt])
}

model team_score {
  id           Int      @id @default(autoincrement())
  teamRoundId  Int      @map("team_round_id")
  hole         Int
  par          Int
  gross        Int
  net          Int
  adjusted     Int
  popsReceived Int?     @map("pops_received")
  points       Float    @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  teamRound team_round @relation(fields: [teamRoundId], references: [id])

  @@unique([teamRoundId, hole])
  @@index([hole])
}

model league_invitation {
  id          Int       @id @default(autoincrement())
  leagueId    Int       @map("league_id")
  playerId    Int?      @map("player_id")
  email       String
  token       String    @unique
  status      String    @default("pending") // pending, claimed, revoked, expired
  invitedById Int       @map("invited_by_id")
  claimedById Int?      @map("claimed_by_id")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  league    league  @relation(fields: [leagueId], references: [id])
  player    player? @relation(fields: [playerId], references: [id])
  invitedBy user    @relation("league_invitation_invited_by", fields: [invitedById], references: [id])
  claimedBy user?   @relation("league_invitation_claimed_by", fields: [claimedById], references: [id])

  @@index([leagueId])
  @@index([playerId])
  @@index([email])
  @@index([status])
  @@index([deletedAt])
}

model league_announcement {
  id           Int       @id @default(autoincrement())
  leagueId     Int       @map("league_id")
  authorUserId Int       @map("author_user_id")
  title        String
  body         String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  league     league                          @relation(fields: [leagueId], references: [id])
  author     user                            @relation(fields: [authorUserId], references: [id])
  dismissals league_announcement_dismissal[]

  @@index([leagueId])
  @@index([authorUserId])
  @@index([createdAt])
  @@index([deletedAt])
}

model league_announcement_dismissal {
  id             Int      @id @default(autoincrement())
  announcementId Int      @map("announcement_id")
  userId         Int      @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  announcement league_announcement @relation(fields: [announcementId], references: [id])
  user         user                @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
}

model audit_log {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  leagueId  Int?     @map("league_id")
  entity    String
  entityId  Int?     @map("entity_id")
  action    String
  summary   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   user?   @relation(fields: [userId], references: [id])
  league league? @relation(fields: [leagueId], references: [id])

  @@index([userId])
  @@index([leagueId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model league_onboarding {
  id                   Int       @id @default(autoincrement())
  leagueId             Int       @unique @map("league_id")
  dismissed            Boolean   @default(false)
  playersReviewedAt    DateTime? @map("players_reviewed_at") @db.Timestamptz(3)
  teamsReviewedAt      DateTime? @map("teams_reviewed_at") @db.Timestamptz(3)
  firstEventCreatedAt  DateTime? @map("first_event_created_at") @db.Timestamptz(3)
  scorecardsPrintedAt  DateTime? @map("scorecards_printed_at") @db.Timestamptz(3)
  firstScoresEnteredAt DateTime? @map("first_scores_entered_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  league league @relation(fields: [leagueId], references: [id])
}
