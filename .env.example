PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/golf
CLIENT_URL=http://localhost:5173
# Comma- or whitespace-separated additional browser origins. Railway host-only domains are accepted
# and normalized to HTTPS, but full https:// URLs are recommended in production.
CLIENT_URLS=
GOLF_API_KEY=
SESSION_SECRET=replace-with-a-long-random-secret
DEMO_SEED_PASSWORD=replace-with-a-local-demo-password

# Production super-admin provisioning (`npm run db:provision:super`)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=
STRIPE_PRODUCT_TAX_CODE=txcd_10103000
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/leagues?checkout=registration_success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/?checkout=registration_cancel#register

# Billing config
BILLING_MIN_GOLFERS=8
BILLING_PRICE_PER_GOLFER_CENTS=1000
BILLING_CURRENCY=usd

# Email notifications (Resend)
# Store the real API key only in .env or your deployment environment.
RESEND_API_KEY=
EMAIL_FROM=League Night Pro <onboarding@resend.dev>
SIGNUP_NOTIFICATION_FROM=
SIGNUP_NOTIFICATION_TO=adamkrieger87@gmail.com
# For production, replace EMAIL_FROM with an address on your verified Resend domain.
# Optional override for course requests; otherwise EMAIL_FROM is used.
COURSE_REQUEST_FROM=
# Support recipient and optional sender; the sender domain must be verified with Resend.
SUPPORT_EMAIL=support@leaguenightpro.com
SUPPORT_EMAIL_FROM=League Night Pro Support <support@leaguenightpro.com>
