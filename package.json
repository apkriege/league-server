{
  "name": "golf-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "nodemon --exec ts-node --files src/dev.ts",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "./scripts/run-with-test-db.sh npx vitest run --config vitest.integration.config.mts",
    "test:e2e": "./scripts/run-with-test-db.sh npm --prefix ../client run test:e2e",
    "seed:demo": "npx ts-node prisma/seed.ts",
    "db:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "db:migrate:deploy": "npx prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:provision:super": "node scripts/createUsers.js",
    "db:migrate:reset": "node scripts/ensureNonProduction.js && npx prisma migrate reset --force --schema=./prisma/schema.prisma",
    "db:full": "npm run db:migrate:reset && npm run seed:demo",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down -v",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "pg": "^8.16.3",
    "prisma": "^6.19.2",
    "resend": "^6.18.1",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "nanoid": "^5.1.6",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.5"
  }
}
